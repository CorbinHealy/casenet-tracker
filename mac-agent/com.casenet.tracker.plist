<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent that runs the full daily CaseNet pipeline at 6:00 AM local time.

  This file is a TEMPLATE. The setup.sh script substitutes __REPO_DIR__ with
  the actual path to your local repo, then writes the result to
  ~/Library/LaunchAgents/com.casenet.tracker.plist.

  Don't load this template directly — run mac-agent/setup.sh instead.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.casenet.tracker</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_DIR__/run.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- If the Mac was asleep at 6 AM, run as soon as it wakes. -->
  <key>RunAtLoad</key>
  <false/>

  <!-- Pause briefly between retries if the script exits non-zero. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>__REPO_DIR__/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__REPO_DIR__/logs/launchd.err</string>
</dict>
</plist>
